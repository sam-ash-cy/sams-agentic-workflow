{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sams-agentic-workflow settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grilling": {
          "type": "boolean",
          "default": true
        },
        "tdd": {
          "type": "boolean",
          "default": true
        },
        "code_review": {
          "type": "boolean",
          "default": true
        },
        "security_review": {
          "type": "boolean",
          "default": true
        },
        "verify_hook": {
          "type": "boolean",
          "default": true
        },
        "budgets": {
          "type": "boolean",
          "default": true
        },
        "compact_nudge": {
          "type": "boolean",
          "default": true
        },
        "style_hook": {
          "type": "boolean",
          "default": true
        },
        "format_hook": {
          "type": "boolean",
          "default": true
        },
        "trail": {
          "type": "boolean",
          "default": false
        },
        "obsidian": {
          "type": "boolean",
          "default": true
        },
        "metrics": {
          "type": "boolean",
          "default": true
        },
        "dashboard": {
          "type": "boolean",
          "default": true
        },
        "retro": {
          "type": "boolean",
          "default": true
        },
        "audit": {
          "type": "boolean",
          "default": true
        },
        "worktrees": {
          "type": "boolean",
          "default": true
        },
        "parallel_sessions": {
          "type": "boolean",
          "default": false
        },
        "branch_guard": {
          "type": "boolean",
          "default": true
        },
        "unslop": {
          "type": "boolean",
          "default": false
        },
        "brag": {
          "type": "boolean",
          "default": false
        },
        "docs_step": {
          "type": "boolean",
          "default": true
        },
        "living_docs": {
          "type": "boolean",
          "default": true
        },
        "implementer": {
          "type": "boolean",
          "default": false
        },
        "about_me": {
          "type": "boolean",
          "default": true
        },
        "recommend": {
          "type": "boolean",
          "default": true
        },
        "skill_finder": {
          "type": "boolean",
          "default": true
        },
        "advisor": {
          "type": "boolean",
          "default": true
        },
        "task_skills": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "task_skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan": {
          "type": "array",
          "default": [
            "mattpocock-skills:grilling",
            "engineering:architecture"
          ]
        },
        "foundation": {
          "type": "array",
          "default": [
            "engineering:system-design",
            "mattpocock-skills:codebase-design"
          ]
        },
        "design": {
          "type": "array",
          "default": [
            "frontend-design:frontend-design",
            "design:design-critique",
            "web-design-guidelines"
          ]
        },
        "feature": {
          "type": "array",
          "default": [
            "mattpocock-skills:tdd",
            "engineering:testing-strategy"
          ]
        },
        "integration": {
          "type": "array",
          "default": [
            "api-design-rules",
            "engineering:testing-strategy"
          ]
        },
        "debug": {
          "type": "array",
          "default": [
            "mattpocock-skills:diagnosing-bugs",
            "engineering:debug"
          ]
        },
        "spike": {
          "type": "array",
          "default": [
            "mattpocock-skills:prototype",
            "mattpocock-skills:research"
          ]
        },
        "hardening": {
          "type": "array",
          "default": [
            "appsec-review",
            "engineering:tech-debt"
          ]
        },
        "audit": {
          "type": "array",
          "default": [
            "engineering:code-review",
            "appsec-review"
          ]
        }
      }
    },
    "advisor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "default": "claude-opus-5-5"
        }
      }
    },
    "recommend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "manual"
          ]
        },
        "mcp": {
          "type": "boolean",
          "default": true
        },
        "skills": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "pre_pr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": {
          "type": "array",
          "default": []
        },
        "tiers": {
          "type": "array",
          "default": [
            "standard",
            "complex",
            "critical"
          ]
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "default": "web",
          "enum": [
            "web",
            "api",
            "cli",
            "lib",
            "infra"
          ]
        }
      }
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "default": "propose",
          "enum": [
            "suggest",
            "propose",
            "act"
          ]
        },
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commit": {
              "type": "string",
              "default": "ask"
            },
            "push": {
              "type": "string",
              "default": "never"
            },
            "open_pr": {
              "type": "string",
              "default": "ask"
            },
            "add_dependency": {
              "type": "string",
              "default": "ask"
            },
            "self_improve": {
              "type": "string",
              "default": "propose"
            },
            "edit_global": {
              "type": "string",
              "default": "never"
            },
            "spawn_sessions": {
              "type": "string",
              "default": "ask"
            }
          }
        }
      }
    },
    "enforcement": {
      "type": "string",
      "default": "custom",
      "enum": [
        "custom",
        "strict",
        "relaxed"
      ]
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "string",
          "default": "main"
        },
        "mode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "branch",
            "worktree",
            "auto"
          ]
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_tier": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "trivial",
            "standard",
            "complex",
            "critical"
          ]
        },
        "always_grill": {
          "type": "array",
          "default": [
            "complex",
            "critical"
          ]
        },
        "mode": {
          "type": "string",
          "default": "soft",
          "enum": [
            "soft",
            "hard"
          ]
        },
        "auto": {
          "type": "string",
          "default": "suggest",
          "enum": [
            "off",
            "suggest",
            "open"
          ]
        },
        "trivial_max_files": {
          "type": "number",
          "default": 3
        },
        "trivial_max_lines": {
          "type": "number",
          "default": 60
        },
        "critical_paths": {
          "type": "array",
          "default": [
            "**/auth/**",
            "**/*secret*",
            "**/migrations/**",
            "infra/**",
            "**/*.tf",
            ".github/workflows/**"
          ]
        }
      }
    },
    "tdd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "default": "hard",
          "enum": [
            "soft",
            "hard"
          ]
        },
        "playbooks": {
          "type": "array",
          "default": [
            "feature",
            "foundation",
            "integration",
            "debug"
          ]
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "default": "soft",
          "enum": [
            "soft",
            "hard"
          ]
        },
        "warn_at": {
          "type": "number",
          "default": 0.8
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trivial": {
              "type": "number",
              "default": 20000
            },
            "standard": {
              "type": "number",
              "default": 150000
            },
            "complex": {
              "type": "number",
              "default": 600000
            },
            "critical": {
              "type": "number",
              "default": 1000000
            }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "default": "routed",
          "enum": [
            "single",
            "routed"
          ]
        },
        "cheap": {
          "type": "string",
          "default": "haiku"
        },
        "mid": {
          "type": "string",
          "default": "sonnet"
        },
        "strong": {
          "type": "string",
          "default": "opus"
        },
        "roles": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "properties": {
            "explore": {
              "type": "string",
              "default": "cheap"
            },
            "research": {
              "type": "string",
              "default": "cheap"
            },
            "implement": {
              "type": "string",
              "default": "strong"
            },
            "architect": {
              "type": "string",
              "default": "strong"
            },
            "review": {
              "type": "string",
              "default": "mid"
            },
            "security_review": {
              "type": "string",
              "default": "strong"
            },
            "ui_verify": {
              "type": "string",
              "default": "mid"
            }
          }
        },
        "phases": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model": {
                "type": "string"
              },
              "effort": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              },
              "trivial": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "effort": {
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                      "max"
                    ]
                  }
                }
              },
              "standard": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "effort": {
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                      "max"
                    ]
                  }
                }
              },
              "complex": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "effort": {
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                      "max"
                    ]
                  }
                }
              },
              "critical": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "effort": {
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                      "max"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "run": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extends": {
            "type": "string"
          }
        }
      },
      "properties": {
        "require_review_evidence": {
          "enum": [
            "off",
            "agent",
            "review_session"
          ]
        },
        "mode": {
          "type": "string",
          "default": "soft",
          "enum": [
            "soft",
            "hard"
          ]
        },
        "allow_unconfigured": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents_md_max_lines": {
          "type": "number",
          "default": 100
        },
        "claude_md_max_lines": {
          "type": "number",
          "default": 200
        },
        "window_tokens": {
          "type": "number",
          "default": 200000
        },
        "suggest_compact_at": {
          "type": "array",
          "default": [
            0.5,
            0.7
          ]
        },
        "handoff_at": {
          "type": "number",
          "default": 0.85
        },
        "autocompact": {
          "type": "string",
          "default": "inherit",
          "enum": [
            "inherit",
            "on",
            "off"
          ]
        },
        "autocompact_window": {
          "type": "number",
          "default": 0
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quiet": {
          "type": "boolean",
          "default": true
        },
        "max_lines": {
          "type": "number",
          "default": 60
        },
        "full_logs": {
          "type": "string",
          "default": ".saw/logs"
        },
        "rewrite_commands": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tone": {
          "type": "string",
          "default": "normal",
          "enum": [
            "normal",
            "structured",
            "detailed",
            "verbose"
          ]
        },
        "max_words": {
          "type": "number",
          "default": 250
        },
        "by_tier": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trivial": {
              "type": "number",
              "default": 80
            },
            "standard": {
              "type": "number",
              "default": 0
            },
            "complex": {
              "type": "number",
              "default": 0
            },
            "critical": {
              "type": "number",
              "default": 600
            }
          }
        },
        "mode": {
          "type": "string",
          "default": "soft",
          "enum": [
            "soft",
            "hard"
          ]
        }
      }
    },
    "sessions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "new_per": {
          "type": "array",
          "default": [
            "phase",
            "stage",
            "feature"
          ]
        },
        "mode": {
          "type": "string",
          "default": "soft",
          "enum": [
            "soft",
            "hard"
          ]
        }
      }
    },
    "review_session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "when": {
          "type": "array",
          "default": [
            "feature",
            "phase",
            "stage"
          ]
        },
        "mode": {
          "type": "string",
          "default": "both",
          "enum": [
            "grill",
            "audit",
            "both"
          ]
        },
        "budget_by_tier": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trivial": {
              "type": "number",
              "default": 0
            },
            "standard": {
              "type": "number",
              "default": 40000
            },
            "complex": {
              "type": "number",
              "default": 80000
            },
            "critical": {
              "type": "number",
              "default": 150000
            }
          }
        }
      }
    },
    "autopilot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "queue": {
          "type": "string",
          "default": "docs/plans/queue.md"
        },
        "per_item_usd": {
          "type": "number",
          "default": 5
        },
        "max_total_usd": {
          "type": "number",
          "default": 30
        },
        "max_failures": {
          "type": "number",
          "default": 2
        },
        "max_wait": {
          "type": "string",
          "default": "6h"
        },
        "resume_on_limit": {
          "type": "boolean",
          "default": true
        },
        "auto_approve_tiers": {
          "type": "array",
          "default": []
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_usd": {
          "type": "number",
          "default": 3
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "store": {
          "type": "string",
          "default": "repo",
          "enum": [
            "repo",
            "vault",
            "both"
          ]
        },
        "vault_path": {
          "type": "string",
          "default": ""
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "names": {
          "type": "array",
          "default": []
        },
        "flow": {
          "type": "string",
          "default": "main",
          "enum": [
            "main",
            "release-branch"
          ]
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "array",
          "default": [
            "claude"
          ]
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "level": {
          "type": "string",
          "default": "info",
          "enum": [
            "debug",
            "info",
            "warn"
          ]
        }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "panels": {
          "type": "array",
          "default": [
            "outcomes",
            "first_pass_rate",
            "findings_by_category",
            "rework",
            "cost_per_task",
            "promotion_effect",
            "adoption",
            "events",
            "autopilot"
          ]
        },
        "port": {
          "type": "number",
          "default": 4173
        },
        "events_limit": {
          "type": "number",
          "default": 50
        },
        "output": {
          "type": "string",
          "default": ".saw/dashboard.html"
        },
        "obsidian_note": {
          "type": "string",
          "default": ""
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auditors": {
          "type": "array",
          "default": [
            "appsec-review",
            "dependency-audit-rules",
            "web-quality-audit"
          ]
        },
        "triggers": {
          "type": "array",
          "default": [
            "critical",
            "hardening",
            "audit"
          ]
        },
        "token_budget": {
          "type": "number",
          "default": 100000
        }
      }
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "merge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "squash": {
              "type": "boolean",
              "default": true
            },
            "merge_commit": {
              "type": "boolean",
              "default": false
            },
            "rebase": {
              "type": "boolean",
              "default": false
            },
            "delete_branch_on_merge": {
              "type": "boolean",
              "default": true
            },
            "auto_merge": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "protect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branch": {
              "type": "string",
              "default": "main"
            },
            "require_pr": {
              "type": "boolean",
              "default": true
            },
            "required_approvals": {
              "type": "number",
              "default": 1
            },
            "required_checks": {
              "type": "array",
              "default": []
            },
            "block_force_push": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secret_scanning": {
              "type": "boolean",
              "default": true
            },
            "push_protection": {
              "type": "boolean",
              "default": true
            },
            "dependabot_alerts": {
              "type": "boolean",
              "default": true
            },
            "dependabot_fixes": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "labels": {
          "type": "array",
          "default": [
            "tier:trivial",
            "tier:standard",
            "tier:complex",
            "tier:critical"
          ]
        }
      }
    },
    "retro": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repeat_threshold": {
          "type": "number",
          "default": 2
        },
        "proposals_dir": {
          "type": "string",
          "default": "docs/proposals"
        }
      }
    },
    "evals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "type": "string",
          "default": "evals/baseline.json"
        },
        "max_token_increase": {
          "type": "number",
          "default": 0.1
        },
        "runs": {
          "type": "number",
          "default": 3
        }
      }
    },
    "deps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lock": {
          "type": "string",
          "default": "deps.lock.toml"
        },
        "allowed_licences": {
          "type": "array",
          "default": [
            "MIT",
            "Apache-2.0",
            "BSD-2-Clause",
            "BSD-3-Clause",
            "ISC",
            "CC-BY-4.0"
          ]
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "push": {
          "type": "string",
          "default": "never",
          "enum": [
            "never",
            "ask",
            "allow"
          ]
        },
        "destructive_approval": {
          "type": "boolean",
          "default": true
        },
        "deploy_approval": {
          "type": "boolean",
          "default": true
        },
        "no_secrets": {
          "type": "boolean",
          "default": true
        },
        "deny": {
          "type": "array",
          "default": [
            "rm -rf",
            "git push --force",
            "git push -f",
            "curl | sh"
          ]
        }
      }
    }
  }
}

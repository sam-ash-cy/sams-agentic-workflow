{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(saw:*)",
      "Bash(trail:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(gh pr create:*)",
      "Bash(bun add:*)",
      "Bash(npm install:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.claude/settings.json)"
    ]
  },
  "enabledPlugins": {
    "sams-agentic-workflow@sams-agentic-workflow": true
  }
}
